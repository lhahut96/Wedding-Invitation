# Dev server image for `docker compose ... up --watch dev` (see docker-compose.dev.yml).
# Source is synced into /app by compose watch, so no rebuild per code change.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
